{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"inlineSources": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"isolatedModules": true,
		"noEmit": false,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"declarationMap": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
