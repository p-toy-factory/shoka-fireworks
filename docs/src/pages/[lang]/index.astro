---
import DocsPage from "../../components/DocsPage.astro";
import { type Locale, locales } from "../../i18n";

export function getStaticPaths() {
	return locales
		.filter((locale) => locale !== "en")
		.map((locale) => ({
			params: { lang: locale },
			props: { locale },
		}));
}

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
---
<DocsPage locale={locale} />
